# Multi-Modal Emotion Recognition System Environment Configuration

# Server Settings
HOST=0.0.0.0
PORT=8000
DEBUG=False
CORS_ORIGINS=*
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Device Settings ("auto", "cpu", "cuda")
DEVICE=cpu

# Speech Model Settings
SPEECH_MODEL_PATH=models/speech/best_model_CNN.h5
SPEECH_MODEL_TYPE=CNN
AUDIO_SAMPLE_RATE=16000
MFCC_LEN=39

# Text Model Settings
TEXT_MODEL_NAME=j-hartmann/emotion-english-distilroberta-base

# Vision Model Settings
VISION_MODEL_PATH=models/vision/model_image_new50.pth
VISION_IMAGE_SIZE=224
